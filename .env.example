# Chennai Flood Lab — Environment Configuration Template
# Copy this file to .env or .env.local to customize options.

# ==========================================
# Frontend Configuration (frontend/.env.local)
# ==========================================
# URL of the Python FastAPI backend engine proxy target
BACKEND_API_URL=http://127.0.0.1:8000

# Optional direct client-to-API override
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ==========================================
# Backend Configuration
# ==========================================
# Enable legacy heavyweight ML ensemble (requires torch, xgboost, shap from requirements.txt)
# Default is 0 (uses fast bundled standard-library ensemble)
ENABLE_ML=0

# Custom path for the SQLite simulation archive database
# Default: backend/storage/simulations.sqlite3
# SIM_ARCHIVE_DB=backend/storage/simulations.sqlite3

# Port configurations
PORT=3000
BACKEND_PORT=8000
